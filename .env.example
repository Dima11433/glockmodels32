# Токен основного Telegram-бота от @BotFather (ОБЯЗАТЕЛЬНО)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Юзернейм бота без @ (например: glock_models_bot)
BOT_USERNAME=glock_models_bot

# Юзернейм главного администратора без @
ADMIN_USERNAME=your_telegram_username

# ID Telegram группы для уведомлений о заказах и рефералах (например: -1001234567890)
ADMIN_GROUP_ID=-1001234567890

# ID Telegram канала для автопостинга обновлений каталога
UPDATE_CHANNEL_ID=-1004437922263

# Платежные системы (CryptoPay / xRocket)
CRYPTOPAY_TOKEN=
CRYPTOPAY_TESTNET=false
XROCKET_API_KEY=

# Путь к базе данных (если подключен Railway Volume, можно указать /app/data/shop.db или оставить shop.db)
DB_PATH=shop.db
